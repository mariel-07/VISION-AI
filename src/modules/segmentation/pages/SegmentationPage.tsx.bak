import { useState } from 'react';import { Layers3, Upload, Scan } from 'lucide-react';import { inferImage } from '../../../shared/services/api';import { getSettings,makeId,saveAnalysis } from '../../../shared/services/store'
type R={detections:{id:string;label:string;confidence:number;x:number;y:number;width:number;height:number;mask?:number[][]}[];width:number;height:number;duration_ms:number;engine:string}
export default function SegmentationPage(){const [file,setFile]=useState<File|null>(null);const [url,setUrl]=useState('');const [result,setResult]=useState<R|null>(null);const [busy,setBusy]=useState(false);const [error,setError]=useState('');async function run(){if(!file)return;setBusy(true);setError('');try{const r=await inferImage(file,.35,'segment',getSettings().scenario) as R;setResult(r);saveAnalysis({id:makeId('AN'),createdAt:new Date().toISOString(),sourceName:file.name,scenario:getSettings().scenario,mode:'segmentation',engine:'YOLO REAL',durationMs:r.duration_ms,detections:r.detections,patterns:['Segmentación de instancias'],alerts:[],imageData:url,width:r.width,height:r.height,volumeCm3:null})}catch(e){setError(e instanceof Error?e.message:'Error')}finally{setBusy(false)}}return <div className="module-page"><div className="page-heading"><div><span className="eyebrow">VISIÓN IA</span><h1>Segmentación</h1><p>Ejecuta el modelo YOLO-seg para obtener regiones/máscaras de instancia cuando estén disponibles.</p></div></div><div className="module-columns"><section className="panel"><div className="panel-heading"><div><h3>Entrada de segmentación</h3><p>Modelo YOLOv8n-seg del backend</p></div><Layers3 size={18}/></div><label className="upload-drop"><Upload size={25}/><b>Selecciona una imagen</b><small>JPG, PNG o WEBP · máximo 12 MB</small><input type="file" accept="image/png,image/jpeg,image/webp" hidden onChange={e=>{const f=e.target.files?.[0];if(f){setFile(f);setUrl(URL.createObjectURL(f));setResult(null)}}}/></label>{file&&<div className="file-picked">{file.name}<button className="primary-button small" disabled={busy} onClick={run}><Scan size={14}/>{busy?'Procesando…':'Segmentar imagen'}</button></div>}{error&&<div className="error-banner">{error}</div>}</section><section className="panel"><div className="panel-heading"><div><h3>Resultado</h3><p>{result?`${result.detections.length} instancias · ${result.duration_ms.toFixed(0)} ms`:'Máscaras detectadas por modelo'}</p></div></div>{url?<div className="seg-image-wrap"><img className="seg-preview" src={url}/>{result&&<svg className="seg-mask-overlay" viewBox={`0 0 ${result.width} ${result.height}`} preserveAspectRatio="none">{result.detections.filter(d=>d.mask&&d.mask.length>2).map((d,i)=><polygon key={d.id} points={d.mask!.map(p=>`${p[0]*result.width},${p[1]*result.height}`).join(' ')} fill={`hsl(${(i*73+155)%360} 78% 55% / .32)`} stroke={`hsl(${(i*73+155)%360} 78% 45%)`} strokeWidth={3}/>)}</svg>}</div>:<div className="empty-state"><Layers3 size={28}/><b>Sin imagen de entrada</b></div>}{result&&<div className="seg-results">{result.detections.map(d=><div className="detection-row" key={d.id}><span className="detection-color"/><div><b>{d.label}</b><small>{d.mask?'Máscara disponible':'Sin máscara para esta instancia'}</small></div><strong>{(d.confidence*100).toFixed(0)}%</strong></div>)}</div>}</section></div><div className="info-strip"><Layers3 size={16}/> El modelo de segmentación es distinto del detector YOLO estándar. Si no se descargó el peso `yolov8n-seg.pt`, el backend lo descargará en su primer inicio.</div></div>}
