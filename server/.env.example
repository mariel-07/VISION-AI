# =============================================================================
# VISION AI - CONFIGURACIÓN DEL SERVIDOR YOLO (FASTAPI)
# =============================================================================

YOLO_MODEL=yolov8n.pt
YOLO_SEG_MODEL=yolov8n-seg.pt
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-proyecto.vercel.app
PORT=8000

# Pesos opcionales entrenados por escenario (dejar vacío usa el modelo general COCO)
YOLO_MODEL_SECURITY=
YOLO_MODEL_WAREHOUSE=
YOLO_MODEL_QUALITY=
YOLO_MODEL_RETAIL=

# -----------------------------------------------------------------------------
# NOTIFICACIONES A TELEGRAM (Alertas de prioridad Alta y Crítica a tu Celular)
# 1. Obtén tu Bot Token creando un bot con @BotFather en Telegram
# 2. Obtén tu Chat ID consultando a @userinfobot en Telegram
# 3. Presiona /start en tu bot para autorizar el envío de mensajes
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_SECONDS=45
