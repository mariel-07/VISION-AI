# =============================================================================
# VISION AI - VARIABLES DE ENTORNO DEL FRONTEND
# =============================================================================

# Backend YOLO FastAPI (dejar vacío si usas el modo Edge WebAssembly sin backend)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# -----------------------------------------------------------------------------
# GOOGLE GEMINI API (Auditoría Forense Multimodal HSE / OSHA / ISO 45001)
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# TELEGRAM BOT API (Notificaciones de Alerta Alta y Crítica a tu Celular)
# 1. Obtén tu Bot Token creando un bot con @BotFather en Telegram
# 2. Obtén tu Chat ID consultando a @userinfobot en Telegram
# 3. Inicia el bot desde tu celular presionando /start
# -----------------------------------------------------------------------------
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
VITE_TELEGRAM_ALERTS_ENABLED=true
VITE_TELEGRAM_COOLDOWN_SECONDS=45
